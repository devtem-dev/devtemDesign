/* =====================================================
   HERO
   ===================================================== */
.hero {
  pos: relative; z: 2;
  min-h: calc(100vh - var(--nav-h));
  min-h: calc(100dvh - var(--nav-h));
  display: flex; fdir: column; ai: center; jc: center; ta: center;
  p: 80px 24px 70px;
  outline: none;
}

.hero-badge {
  display: inline-flex; ai: center; gap: 8px; mb: 28px;
  ff: monospace; fs: 0.7rem; ls: 0.14em; tt: uppercase; color: var(--accent);
  p: 6px 16px;
  border: 1px solid var(--glass-border);
  rounded: var(--radius-pill);
  bg: var(--surface);
}

.hero-title {
  fs: clamp(2.4rem, 8vw, 5.8rem);
  fw: 800; lh: 1.05; ls: -0.025em;
  mb: 20px; max-w: 18ch;
  text-wrap: balance;
}
.hero-title .gradient {
  bg: linear-gradient(120deg, var(--accent), var(--accent2), var(--accent3), var(--accent));
  background-size: 250% auto;
  animation: shine 8s linear infinite;
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent;
}
@keyframes shine { to { background-position: 250% center; } }

.hero-sub {
  fs: 1.05rem; color: var(--muted);
  max-w: 540px; lh: 1.65;
  mx: auto; mb: 36px;
  text-wrap: pretty;
}

.hero-actions {
  display: flex; gap: 14px; jc: center; fwrap: wrap;
}

.hero-brands {
  mt: 56px; max-w: 820px; w: 100%; p: 24px 20px;
  bg: var(--glass-bg);
  border: 1px solid var(--glass-border);
  backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur);
  rounded: 28px;
}
.hero-brands-row {
  display: flex; fwrap: wrap; jc: center; gap: 10px 14px; ai: center; fs: 0.85rem;
}
.dot-sep { color: var(--muted); }
.hero-brands-caption { mt: 14px; fs: 0.75rem; color: var(--muted); }

/* ----- MARQUEE ----- */
.marquee-section {
  pos: relative; z: 2; py: 22px; ov: hidden;
  border-top: 1px solid var(--glass-border);
  border-bottom: 1px solid var(--glass-border);
  bg: var(--surface);
  -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
}
.marquee-track {
  display: flex; w: max-content; ws: nowrap;
  animation: marqueeX 34s linear infinite;
}
.marquee-section:hover .marquee-track { animation-play-state: paused; }
.marquee-item {
  display: flex; ai: center; gap: 12px; pr: 64px;
  ff: monospace; fs: 0.78rem; ls: 0.18em; tt: uppercase; color: var(--muted);
}
.marquee-dot {
  size: 5px; bg: var(--accent); rounded: 50%;
}
@keyframes marqueeX { to { transform: translateX(-50%); } }
